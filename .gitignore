#  before PyInstaller builds the exe, so as to inject date/other infos into it
*.manifest
*.spec  
# Installer logs
pip-log.txt
pip-shims
pip-wheel-metadata
# Pyre type checker
.pyre/

# scikit-build
scb-out/
